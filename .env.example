# Claude Code's long-lived token for your Claude plan: run `claude setup-token` and paste what it prints.
# Leave empty to use your current Claude Code login instead.
CLAUDE_CODE_OAUTH_TOKEN=
# The claude binary, if it isn't on PATH: the output of `which claude`.
CLAUDE_CODE_BIN=
# Model alias for the tutor (sonnet is fast; opus is smarter).
CLAUDE_MODEL=sonnet
